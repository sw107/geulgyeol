+        }
+        for m in &s.section_def.master_pages {
+            for p in &m.paragraphs {
+                collect(p, d, &mut ps);
+            }
+        }
+    }
+    let styles: Vec<_> = d
+        .document()
+        .doc_info
+        .styles
+        .iter()
+        .map(|s| {
+            json!([
+                s.local_name,
+                s.english_name,
+                s.char_shape_id,
+                s.para_shape_id,
+                d.document().doc_info.styles[s.next_style_id as usize].local_name
+            ])
+        })
+        .collect();
+    json!({"paragraphs":ps,"styles":styles})
