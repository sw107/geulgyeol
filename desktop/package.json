{
  "name": "geulgyeol-beta",
  "version": "0.4.3-beta.1",
  "private": true,
  "type": "module",
  "description": "Local HWP/HWPX desktop editor powered by RHWP",
  "author": "Geulgyeol contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:mac": "electron-packager . GeulgyeolBeta --platform=darwin --arch=arm64 --electron-version=44.3.0 --out=../dist --app-bundle-id=org.geulgyeol.beta --asar --ignore=^/tests",
    "package:linux": "electron-packager . Baram --platform=linux --arch=x64 --out=../BaramBuilds --overwrite --ignore=^/tests --ignore=^/scripts"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "@electron/packager": "20.3.0"
  },
  "license": "MIT"
}
